    {
      "stepType": "quiz",
      "instruction": "The victim is unresponsive when called. What is the next step?",
      "quizTimeSeconds": 15,
      "lowTimeCueSeconds": 3,
      "backgroundImage": "Korban Jatuh",
      "optionParentTarget": "optionParents2",
      "optionParentPosX": -150.0,
      "optionParentPosY": -230.0,
      "options": [
        {
          "text": "Immediately perform CPR",
          "isCorrect": false,
          "feedback": "Check breathing condition first before CPR."
