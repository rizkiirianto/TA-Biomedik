      "goldTime": 10,
      "silverTime": 15,
      "options": []
    },
    {
      "stepType": "quiz",
      "instruction": "The victim is not breathing and is unconscious. What is your action?",
      "quizTimeSeconds": 15,
      "lowTimeCueSeconds": 3,
      "backgroundImage": "Korban Terbaring",
      "optionParentTarget": "optionParents2",
      "optionParentPosX": -150.0,
      "optionParentPosY": -230.0,
      "options": [
        {
          "text": "Wait for the ambulance to arrive",
          "isCorrect": false,
          "feedback": "Too long! Every second counts."
