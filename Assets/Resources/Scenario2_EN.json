        {
          "text": "Check the victim's breathing",
          "isCorrect": true,
          "narrative": "Correct! Check if the victim is breathing normally.",
          "narrativeImage": "Tidak Bernapas"
        },
        {
          "text": "Give the victim a drink",
          "isCorrect": false,
          "feedback": "Dangerous! An unconscious victim could choke."
        }
      ]
    },
    {
      "stepType": "dialog",
      "speakerName": "Narrator",
      "instruction": "You don't see the victim's chest rising and falling. The victim is not breathing.",
      "narrativeImage": "Tidak Bernapas",
      "options": []
    },
    {
      "stepType": "minigame",
      "instruction": "There is no more time, I have tried my best to give the information.",
