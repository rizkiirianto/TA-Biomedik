  m_Script: {fileID: 11500000, guid: 11971b37e8f500f4badac1835d6408fb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneCallTechnician
  dialogText: {fileID: 6198244596335425764}
  advanceButton: {fileID: 2201312481160382109}
  dialogPanelRoot: {fileID: 4921101150332691753}
  gambarJiroBiasa: {fileID: 6556989209759125603}
  gambarJiroNelpon: {fileID: 8525132418972044159}
  gambarJiroKaget: {fileID: 7986709900372974541}
  gambarPakRaka: {fileID: 6832143057502405343}
  gambarRuangTamuMatiTengah: {fileID: 4469223191194075556}
  gambarTetanggaDatang: {fileID: 1284579728402630816}
  gambarPerbaikiLampu: {fileID: 834620900341356870}
  gambarTersetrum: {fileID: 722568529089436631}
  gambarLampuKonslet: {fileID: 6598106404225108565}
  audioSource: {fileID: 3127018201546946988}
  typewriterSound: {fileID: 8300000, guid: 88b36b5273eb88e45b5452fc1d8d51e2, type: 3}
  dialSound: {fileID: 8300000, guid: fe5c24276b4b7c1439abca81e095f5b3, type: 3}
  pintuTerbukaSound: {fileID: 8300000, guid: 20008c67fa31f9e46a2a952cc722d07e, type: 3}
  electricDischargeSound: {fileID: 8300000, guid: 07f126f012ccc664d8719e5f2c9097d6, type: 3}
  jiroScreamSound: {fileID: 8300000, guid: 65b9117d61cddb64fa56e165af194456, type: 3}
  dialogueLines:
  - 'Jiro : Coba telepon Pak Raka, tetangga sebelah. Beliau biasanya ngerti listrik.'
  - '*nada sambung telepon terdengar di tengah suara hujan deras*'
  - 'Pak Raka (telepon): Halo, Jiro? Tumben malam-malam gini telpon, ada apa?'
  - 'Jiro : Maaf ganggu, Pak. Ini ketika saya sampai rumah tau tau lampu di ruang
    tamu saya berkedip terus menerus.'
  - 'Pak Raka (telepon): Cuma satu lampu atau satu rumah?'
  - 'Jiro : Cuma satu pak lampu ruang tamu aja'
  - 'Pak Raka (telepon) : Oh yaudah saya kesana aja buat ngecek'
  - 'Jiro : Siap pak, makasih banyak'
  - 10 menit kemudian
  - 'Pak Raka : Wah hujannya deras sekali'
  - 'Jiro : Mari pak masuk dulu saya ambilkan handuk'
  - 'Pak Raka : Aman Jiro, saya langsung cek aja lampunya yaa'
  - 'Jiro : Apa perlu saya matikan dulu listriknya pak?'
  - 'Pak Raka : Santai ajaa, paling cuma longgar kabelnya'
  - 'Jiro : Eh pak mending keringkan badan dulu ga sih pak daripada resiko kesetr-'
  - '*krrrzzzt! suara percikan listrik terdengar*'
  - 'Jiro : PAK RAKAA!!!'
  typingSpeed: 0.035
  hideDialogAfterFinish: 1
  destroyOnFinish: 1
