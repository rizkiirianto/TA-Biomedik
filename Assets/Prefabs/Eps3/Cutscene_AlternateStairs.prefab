  alarmLoopSound: {fileID: 8300000, guid: d4ce3c9db1f24d749862e844d156b227, type: 3}
  nextButton: {fileID: 5844076434311432822}
  destroyOnFinish: 1
  alarmBlinkInterval: 0.25
  dialogueLines:
  - Setelah memilih tangga darurat, ternyata tangga darurat terdekat terbakar dan
    ada reruntuhan yang menghalangi jalan.
  - "Jiro: Aku harus cari jalan lain\u2014ke sisi lain bangunan!"
  - Tangga darurat satunya terlihat aman. Jiro segera beralih ke tangga tersebut
    dan mulai turun.
  - 'Jiro: Turun cepat, jangan berhenti!'
  - Lantai 2 terasa panas, sepertinya asal apinya dari sana, namun syukurlah tangga
    ini masih cukup aman untuk dilewati.
  - Jiro sampai di ujung tangga darurat. Pintu keluar menuju lobby sudah dekat.
  - "Jiro: Aku sampai di lobby. Di sini tampak sepi \u2014 harus segera ke parkiran
    depan!"
  - 'Jiro : Ya Tuhan... gedung kampusku kenapa jadi seperti ini.... Semoga semua
    orang sudah keluar.'
  isNarrator: 0100010001010000
  isJiroTakut: 0000000100000101
  typingSpeed: 0.035
