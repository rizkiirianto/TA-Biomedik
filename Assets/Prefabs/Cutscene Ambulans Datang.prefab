  m_Script: {fileID: 11500000, guid: d93cb531aa5217e4e801c6eadd153cfa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneAmbulans
  narrationText: {fileID: 8598200795308906244}
  audioSource: {fileID: 5790415055286144158}
  typewriterSound: {fileID: 8300000, guid: 88b36b5273eb88e45b5452fc1d8d51e2, type: 3}
  typingSpeed: 0.035
  delayBetweenLines: 1.5
  autoCompleteDelay: 2.5
  destroyOnFinish: 1
  narrationLine: 'Dari kejauhan terdengar suara sirine mendekat dan tak lama kemudian
    ambulans pun tiba.


    Petugas medis segera membawa korban ke dalam ambulans
    untuk mendapatkan penanganan lebih lanjut.

    Berkat tindakan cepat dan tepat
    yang telah dilakukan, kondisi korban dapat ditangani sebelum menjadi lebih buruk.'
