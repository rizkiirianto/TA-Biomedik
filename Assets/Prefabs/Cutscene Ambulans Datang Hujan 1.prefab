  m_EditorClassIdentifier: Assembly-CSharp::CutsceneAmbulans
  narrationText: {fileID: 4106324186152562654}
  nextButton: {fileID: 6068729189107628262}
  audioSource: {fileID: 420582401938864046}
  typewriterSound: {fileID: 8300000, guid: 88b36b5273eb88e45b5452fc1d8d51e2, type: 3}
  typingSpeed: 0.035
  destroyOnFinish: 1
  narrationLine: 'Jiro melakukan CPR hingga ambulans datang membelah hujan.


    Tak
    lama setelah petugas medis datang Pak Raka kembali bernafas dan petugas medis
    segera membawanya ke dalam ambulans untuk mendapatkan penanganan lebih lanjut.


    Meski
    sempat meninggal secara medis, Pak Raka berhasil dibawa kembali oleh Jiro dan
    selamat dengan luka bakar di tangan dan beberapa rusuk yang patah.'
